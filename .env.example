# Xiakeman Community environment reference.
# Copy to .env for local development. Never put real secrets in this example.

# Frontend and development proxy
VITE_DEV_SERVER_PORT=8022
VITE_BFF_PROXY_TARGET=http://localhost:8030
VITE_VOLC_VIRTUAL_HUMAN_CATALOG_URL=/data/volc-virtual-humans.json
VITE_XIAKEMAN_NEXT_UI=false
VITE_SEEDANCE_CLOUD_PROXY_TARGET=http://127.0.0.1:8034
VITE_SEEDANCE_KREA_PROXY_TARGET=http://127.0.0.1:8036

# BFF HTTP service
BFF_PORT=8030
CORS_ORIGIN=http://localhost:8022
NODE_ENV=development
BFF_RATE_LIMIT_MAX=30
BFF_CLOUD_RATE_LIMIT_MAX=1200
BFF_BACKGROUND_JOB_RATE_LIMIT_MAX=600
BFF_IMAGE_PROXY_RATE_LIMIT_MAX=180

# Stable secrets are mandatory for persistent/shared deployments.
# Generate long random values and inject them outside source control.
AUTH_SECRET=
APP_SETTINGS_SECRET=
SETTINGS_ENCRYPTION_KEY=
AUTH_COOKIE_NAME=xiakeman_session
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_DAYS=14
AUTH_ALLOW_REGISTRATION=true
ADMIN_EMAILS=

# Upstream hostname allowlists (comma-separated hostnames, without paths).
LLM_BASE_URL_ALLOWLIST=api.openai.com
IMAGE_BASE_URL_ALLOWLIST=
TTS_BASE_URL_ALLOWLIST=
MUSIC_BASE_URL_ALLOWLIST=
XYQ_AGENT_BASE_ALLOWLIST=xyq.jianying.com

# Optional local/self-hosted video services.
SEEDANCE_API_BASE=http://127.0.0.1:8033/api
SEEDANCE_CLOUD_API_BASE=http://127.0.0.1:8034/api
SEEDANCE_CLOUD_LICENSE_VALIDATE_URL=
REWRITE_LOCALHOST_FOR_DOCKER=true
DOCKER_HOST_GATEWAY=host.docker.internal

# File-backed storage (default and suitable for one BFF instance).
AUTH_STORE_DRIVER=file
CLOUD_STORE_DRIVER=file
BACKGROUND_JOB_STORE_DRIVER=file
APP_SETTINGS_DRIVER=file
AUTH_STORAGE_DIR=
CLOUD_STORAGE_DIR=
BACKGROUND_JOBS_DIR=
APP_SETTINGS_DIR=
CLOUD_PROJECT_JSON_LIMIT=150mb
CLOUD_BLOB_UPLOAD_LIMIT=300mb
CLOUD_DIRECT_BLOB_MAX_BYTES=2147483648
CLOUD_DIRECT_URL_BATCH_LIMIT=200
CLOUD_ALLOW_HEADER_USER=false

# Postgres (set the relevant drivers to postgres when enabled).
DATABASE_URL=
POSTGRES_SSL=
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
POSTGRES_POOL_MAX=10
POSTGRES_CONNECT_TIMEOUT_MS=10000
POSTGRES_IDLE_TIMEOUT_MS=30000

# Large media storage: local or tencent-cos/S3-compatible.
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_LOCAL_DIR=
TENCENT_COS_BUCKET=
TENCENT_COS_REGION=
TENCENT_COS_ENDPOINT=
TENCENT_COS_PREFIX=xiakeman
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
COS_CONNECTION_TIMEOUT_MS=15000
COS_REQUEST_TIMEOUT_MS=180000
COS_MAX_ATTEMPTS=3
COS_SIGNED_URL_TTL_SECONDS=900

# Background worker. Start conservatively, then tune from observed latency.
BACKGROUND_WORKER_ENABLED=true
BACKGROUND_WORKER_CONCURRENCY=8
BACKGROUND_WORKER_STEP1_CONCURRENCY=2
BACKGROUND_WORKER_STEP3_CONCURRENCY=2
BACKGROUND_WORKER_STEP4_CONCURRENCY=2
BACKGROUND_WORKER_IMAGE_CONCURRENCY=4
BACKGROUND_WORKER_LLM_CONCURRENCY=4
BACKGROUND_WORKER_VIDEO_CONCURRENCY=2
BACKGROUND_WORKER_TTS_CONCURRENCY=2
BACKGROUND_WORKER_BGM_CONCURRENCY=1
BACKGROUND_WORKER_RENDER_CONCURRENCY=1
BACKGROUND_WORKER_LEASE_SECONDS=1800
BACKGROUND_WORKER_STALE_SECONDS=240
BACKGROUND_WORKER_TOKEN=

# Rendering and media
FFMPEG_PATH=ffmpeg
RENDER_WORK_DIR=
RENDER_MAX_UPLOAD_BYTES=1610612736
RENDER_JOB_TTL_MS=3600000
RENDER_FAILED_JOB_TTL_MS=300000
VOICE_CORPUS_DIR=

# Image worker timeouts
IMAGE_JOB_TIMEOUT_MS=720000
IMAGE_HTTP_TIMEOUT_MS=600000
IMAGE_DOWNLOAD_TIMEOUT_MS=600000
IMAGE_UPLOAD_TIMEOUT_MS=240000
